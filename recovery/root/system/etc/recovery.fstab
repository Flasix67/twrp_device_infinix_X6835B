# mount point       fstype    device                                                                flags
/system             ext4      /dev/block/by-name/system          flags=display="System";backup=1;slotselect
# /vendor             ext4      /dev/block/by-name/vendor          flags=display="Vendor";backup=1;slotselect
/product            ext4      /dev/block/by-name/product         flags=display="Product";backup=1;slotselect
/data               f2fs      /dev/block/by-name/userdata        flags=display="Data"
/metadata           ext4      /dev/block/by-name/metadata        flags=display="Metadata"
/misc               emmc      /dev/block/by-name/misc            flags=display="Misc"
/boot               emmc      /dev/block/by-name/boot            flags=display="Boot";backup=1;slotselect
# /external_sd        vfat      /dev/block/mmcblk0p1               flags=display="MicroSD";storage;wipeui;removable
/external_sd        vfat      /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=storage;wipeingui;removable
/usb_otg            vfat      /dev/block/sdd1                    flags=display="USB-OTG";storage;wipeui;removable
